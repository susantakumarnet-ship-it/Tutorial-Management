# ---- Server ----
NODE_ENV=development
PORT=4100
# Comma separated list of allowed browser origins (admin dashboard)
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
DATABASE_URL=postgres://postgres:postgres@localhost:5433/smart_tuition

# ---- Auth ----
# Use long random strings in production (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_PEPPER=change-me-otp-pepper
OTP_TTL_SECONDS=300
# When true the OTP is returned in the API response and logged (NEVER enable in production)
OTP_DEV_MODE=true
# SMS provider: console (dev). Plug a real provider into src/services/sms.ts
SMS_PROVIDER=console

# ---- Firebase (optional: phone-auth token exchange + FCM push) ----
# Path to service-account JSON. Leave empty to disable.
FIREBASE_SERVICE_ACCOUNT_PATH=

# ---- File storage ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
