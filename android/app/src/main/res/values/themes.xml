<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartTuition" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Android 12+ style splash (backported by core-splashscreen) -->
    <style name="Theme.SmartTuition.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SmartTuition</item>
    </style>
</resources>
